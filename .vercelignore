# =============================================================================
# .vercelignore — Vercel Frontend-Only Build Configuration
# =============================================================================
# The backend (FastAPI) is deployed on Render, NOT Vercel.
# Vercel only builds the Vite React frontend (frontend/).
# ALL Python/backend files must be excluded to prevent Vercel from attempting
# a serverless Python function build (which causes dependency conflicts).
# =============================================================================

# --- Python backend: exclude entirely ---
api/
src/
models/
data/
tests/
scripts/
notebooks/
supabase/
medical_risk/

# --- Python entrypoints (prevent serverless function detection) ---
index.py
requirements.txt
Dockerfile
render.yaml
pyproject.toml
Pipfile
Pipfile.lock
setup.py
setup.cfg

# --- Python runtime artifacts ---
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.python-version

# --- Database files ---
*.db
*.db-shm
*.db-wal
*.db.bak*
*.sqlite
*.sqlite3

# --- Environment & secrets ---
.env
.env.local
.env.*.local
.env.example

# --- Dev/build artifacts ---
brag-output/
brag_repo/
SECURITY_*.md
SECURITY_*.py
IMPLEMENTATION_SUMMARY.md
COMPLETE_SUMMARY.md
DATABASE_PERSISTENCE_UPDATE.md
