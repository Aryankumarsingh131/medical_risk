# =============================================================================
# .vercelignore — Vercel Frontend-Only Build Configuration
# =============================================================================
# Architecture:
#   - Vercel  → Vite React frontend ONLY  (frontend/ → dist/)
#   - Render  → FastAPI Python backend    (api/main.py via uvicorn)
#
# Predictions are deterministic rule/score-based (calculate_rule_based_risk).
# XGBoost/SHAP run in background on Render ONLY — not needed by Vercel at all.
# ALL Python / backend / ML files must be excluded here.
# =============================================================================

# ── Python backend source ────────────────────────────────────────────────────
api/
src/
medical_risk/

# ── ML model artefacts & trained weights ────────────────────────────────────
models/
*.joblib
*.pkl
*.pickle
*.h5
*.pt
*.pth
*.onnx

# ── Training data ────────────────────────────────────────────────────────────
data/

# ── Notebooks & scripts ──────────────────────────────────────────────────────
notebooks/
scripts/

# ── Tests ────────────────────────────────────────────────────────────────────
tests/

# ── Supabase / infra config ──────────────────────────────────────────────────
supabase/

# ── Python dependency / entrypoint files ─────────────────────────────────────
# Excluding requirements.txt prevents Vercel from attempting a Python build
requirements.txt
Pipfile
Pipfile.lock
pyproject.toml
setup.py
setup.cfg
index.py
Dockerfile
render.yaml
run_all.py
SECURITY_PATCHES.py

# ── Python runtime artefacts ─────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.python-version

# ── Database files ───────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db.bak*
*.sqlite
*.sqlite3

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.example

# ── Dev / one-off output ─────────────────────────────────────────────────────
brag-output/
brag_repo/

# ── Markdown docs not needed by frontend ─────────────────────────────────────
SECURITY_*.md
IMPLEMENTATION_SUMMARY.md
COMPLETE_SUMMARY.md
DATABASE_PERSISTENCE_UPDATE.md
