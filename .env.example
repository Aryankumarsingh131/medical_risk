# Environment variables — copy this file to .env and fill in your actual values.
# NEVER commit the real .env to version control. Only commit .env.example.

# ---- Database ----
# SQLite (default): sqlite:///./medical_risk.db
# PostgreSQL example: postgresql://user:password@localhost:5432/medical_risk_db
DATABASE_URL=sqlite:///./medical_risk.db

# ---- JWT Authentication ----
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-key-minimum-32-chars

# Token expiry in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Frontend Configuration ----
# Backend API URL used by Vite frontend
VITE_API_URL=http://127.0.0.1:8000

# ---- Model versioning ----
MODEL_VERSION=1.0.0
